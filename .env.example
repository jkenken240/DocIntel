# Docker Compose bind mounts. Keep project-owned persistent data on E:.
DOCINTEL_POSTGRES_DATA_PATH=E:/DocIntelData/postgres
DOCINTEL_UPLOADS_DATA_PATH=E:/DocIntelData/uploads
DOCINTEL_PROCESSED_DATA_PATH=E:/DocIntelData/processed
DOCINTEL_SAMPLES_DATA_PATH=E:/DocIntelData/samples
DOCINTEL_BACKUPS_DATA_PATH=E:/DocIntelData/backups

# Local development database. Compose overrides the hostname to "db" inside containers.
DOCINTEL_POSTGRES_USER=docintel
DOCINTEL_POSTGRES_PASSWORD=docintel_local_only
DOCINTEL_POSTGRES_DB=docintel
DOCINTEL_DATABASE_URL=postgresql+psycopg://docintel:docintel_local_only@localhost:5432/docintel

# Paths used when the API runs directly on Windows rather than in Compose.
DOCINTEL_UPLOADS_PATH=E:/DocIntelData/uploads
DOCINTEL_PROCESSED_PATH=E:/DocIntelData/processed
DOCINTEL_SAMPLES_PATH=E:/DocIntelData/samples
DOCINTEL_BACKUPS_PATH=E:/DocIntelData/backups

DOCINTEL_ENVIRONMENT=development
DOCINTEL_LOG_LEVEL=INFO
DOCINTEL_CORS_ORIGINS=["http://localhost:5173"]
DOCINTEL_UPLOAD_MAX_BYTES=26214400
DOCINTEL_UPLOAD_CHUNK_BYTES=65536
DOCINTEL_PDF_MAX_PAGES=500
DOCINTEL_PROCESSING_VERSION=phase4-v1
DOCINTEL_PROCESSING_JOB_MAX_ATTEMPTS=3
DOCINTEL_PROCESSING_RETRY_BASE_SECONDS=2
DOCINTEL_EMBEDDING_BATCH_SIZE=32
DOCINTEL_MOCK_EMBEDDING_MODEL=mock-hash-v1
DOCINTEL_CHUNK_TARGET_CHARS=1400
DOCINTEL_CHUNK_MAX_CHARS=1800
DOCINTEL_CHUNK_OVERLAP_CHARS=200
DOCINTEL_CHUNKER_VERSION=deterministic-char-v1
DOCINTEL_QUESTION_MAX_CHARS=2000
DOCINTEL_QUESTION_MAX_DOCUMENTS=20
DOCINTEL_RETRIEVAL_CANDIDATE_POOL=40
DOCINTEL_RETRIEVAL_EVIDENCE_COUNT=6
DOCINTEL_RETRIEVAL_MINIMUM_SIMILARITY=0.05
DOCINTEL_RETRIEVAL_MAX_CHUNKS_PER_PAGE=2
DOCINTEL_RETRIEVAL_MAX_CHUNKS_PER_DOCUMENT=3
DOCINTEL_RETRIEVAL_MMR_LAMBDA=0.75
DOCINTEL_RETRIEVAL_DUPLICATE_OVERLAP_RATIO=0.7
DOCINTEL_MOCK_ANSWER_MODEL=mock-grounded-v1
DOCINTEL_MOCK_VERIFIER_MODEL=mock-claim-verifier-v1
DOCINTEL_AI_TIMEOUT_SECONDS=20
DOCINTEL_AI_MAX_RESPONSE_BYTES=65536
DOCINTEL_DELETION_JOB_MAX_ATTEMPTS=3
DOCINTEL_DELETION_RETRY_BASE_SECONDS=5
DOCINTEL_WORKER_POLL_SECONDS=1
DOCINTEL_WORKER_LEASE_SECONDS=30

# Offline mock providers are the default. OpenAI-compatible providers remain
# disabled unless the provider and every required value are explicitly configured.
DOCINTEL_AI_PROVIDER=mock
DOCINTEL_EMBEDDING_DIMENSIONS=1536
DOCINTEL_AI_BASE_URL=
DOCINTEL_AI_API_KEY=
DOCINTEL_AI_CHAT_MODEL=
DOCINTEL_AI_EMBEDDING_MODEL=
DOCINTEL_AI_STRUCTURED_OUTPUT=true

DOCINTEL_API_PORT=8000
DOCINTEL_WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
